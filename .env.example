# Flask
SECRET_KEY=change_me_to_a_long_random_string
FLASK_DEBUG=True

# Database (MySQL). Create the database first, then fill this in.
DATABASE_URL=mysql+pymysql://username:password@localhost/printing_management

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=15

# AI Chatbot (optional - falls back to local FAQ if not set)
AI_PROVIDER=anthropic
AI_API_KEY=your_api_key_here
AI_MODEL=claude-sonnet-4-6
AI_API_URL=https://api.anthropic.com/v1/messages

# Initial admin account (used only by database/seed.py)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_admin_password
INITIAL_ADMIN_EMAIL=admin@printcare.local
